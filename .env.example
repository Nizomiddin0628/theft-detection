# Telegram bot tokeni (BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Web panelga kirish — PAROLNI ALBATTA O'ZGARTIRING (standart parol bilan panel tarmoqdagi hammaga ochiq)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Server manzili. 0.0.0.0 — tarmoqdagi boshqa qurilmalardan ham ochiladi; faqat shu kompyuter uchun 127.0.0.1
HOST=0.0.0.0
PORT=8000

# Ixtiyoriy: panel internetda ochiq bo'lsa (masalan https://dokon.example.uz),
# Telegram xabarida "Panelda ochish" tugmasi paydo bo'ladi. Teskari proksi (nginx) ishlatilsa, u
# "X-Forwarded-For" va "Host" sarlavhalarini uzatsin — shunda login himoyasi va CSRF tekshiruvi to'g'ri ishlaydi
PUBLIC_URL=

# 3.2.0: panel faqat IP, kompyuter nomi (.local, .lan) va PUBLIC_URL bilan ochiladi (DNS rebinding himoyasi).
# Boshqa domen (tunnel, proksi) orqali ochilsa — vergul bilan yozing, masalan: ALLOWED_HOSTS=panel.dokon.uz
ALLOWED_HOSTS=

# Ixtiyoriy: bulut (markaziy server). Berilsa hodisalar, kliplar, kamera holati va daqiqalik ko'rsatkichlar
# o'sha serverga yuboriladi; internet bo'lmasa shu kompyuterda navbatda saqlanadi, ulanish tiklangach ketadi.
# Bulut qabul qiluvchi: python -m cloud.server --port 9000  (unga ham shu EDGE_TOKEN beriladi)
# Token yaratish: python -c "import secrets; print(secrets.token_hex(16))"
CLOUD_URL=
EDGE_TOKEN=
# Bulut serveri (cloud/server.py) uchun: baza (bo'sh — SQLite cloud/data/cloud.db; VPS'da PostgreSQL) va
# superadmin tokeni (barcha kompaniyalar bo'yicha ko'rish; bo'sh — o'chirilgan)
# CLOUD_DB_URL=postgresql+psycopg://hushyor:parol@127.0.0.1:5432/hushyor
CLOUD_ADMIN_TOKEN=

# Bulut bildirishnomalari (1.7.0) — faqat bulut serveri o'qiydi. Hammasi ixtiyoriy: berilmagan kanal o'chiq.
# Bulut Telegram boti — @BotFather'da ALOHIDA bot yarating (yuqoridagi do'kon botining tokeni bilan bir xil bo'lsa,
# bulut boti o'chadi). Xodim panelda Sozlamalar → "Telegram'ni ulash" ni bosib o'zini bog'laydi.
CLOUD_TELEGRAM_BOT_TOKEN=
# Panelning internetdagi manzili (havolalar va xabardagi "Panelda ochish" uchun), masalan https://panel.dokon.uz
CLOUD_PUBLIC_URL=
# Email (SMTP). CLOUD_SMTP_TLS: starttls (587), ssl (465) yoki none
CLOUD_SMTP_HOST=
CLOUD_SMTP_PORT=587
CLOUD_SMTP_USER=
CLOUD_SMTP_PASSWORD=
CLOUD_SMTP_FROM=
CLOUD_SMTP_TLS=starttls
# Brauzer push: kalit o'zi yaratiladi; bu yerga aloqa manzili (push xizmatlari talab qiladi)
CLOUD_VAPID_SUB=mailto:admin@dokon.uz
# Xabarlardagi vaqt (UTC dan farq, soat; O'zbekiston = 5)
CLOUD_TZ_OFFSET=5
# Do'kon bilan aloqa necha daqiqa yo'q bo'lsa xabar; hodisa necha daqiqa tekshirilmasa menejer/egasiga eslatma
CLOUD_OFFLINE_MIN=5
CLOUD_ESCALATE_MIN=10
# Sayt (2.6.0, bulut serveri /sayt/ da beradi): aloqa qatorlari — berilmagani saytda ko'rsatilmaydi
CLOUD_SITE_PHONE=
CLOUD_SITE_TELEGRAM=
CLOUD_SITE_EMAIL=
CLOUD_SITE_ADDRESS=
# Narx matni (bo'sh — "so'rov bo'yicha")
CLOUD_SITE_PRICE=
# Saytdagi so'rovlar: bulut boti shu guruhga yuboradi (botni guruhga qo'shing va guruhda /chatid yozing) va/yoki email
CLOUD_LEADS_CHAT=
CLOUD_LEADS_EMAIL=

# Ixtiyoriy (2.2.0): kritik SMS — yiqilish, tungi kirish va boshqa xavfsizlik signallari telefonga ham.
# Panel: Xavfsizlik → Kritik SMS (yoqish, telefonlar, turlar). Login/parol faqat shu yerda (bazaga yozilmaydi).
# Eskiz.uz: kabinetdagi email va parol; SMS_FROM — jo'natuvchi nomi/raqami (sukut 4546).
# DIQQAT: Eskiz har SMS matnini moderatsiya qiladi — avval kabinetda shablonni tasdiqlating.
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=
SMS_FROM=4546
# Boshqa shlyuz: POST SMS_HTTP_URL, JSON {"phone": "998...", "text": "..."}, Authorization: Bearer SMS_HTTP_TOKEN
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# Ixtiyoriy: AI uchun CPU oqimlari soni (bo'sh qoldirilsa — avtomatik: yadrolar - 2, ko'pi bilan 4).
# Kompyuter qotib qolsa 2 qiling.
AI_THREADS=
